# Community Tutors — local development
# Copy to .env and adjust. Never commit real secrets.

DATABASE_URL="postgresql://community_tutors:community_tutors_dev@localhost:5432/community_tutors?schema=public"

AUTH_SECRET="dev-only-change-me-to-a-long-random-string"
AUTH_URL="http://localhost:3000"
# Optional Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend — leave empty to log emails to console (demo mode)
RESEND_API_KEY=""
EMAIL_FROM="Community Tutors <onboarding@resend.dev>"

# Object storage — local filesystem demo when STORAGE_DRIVER=local
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH=".uploads"
# S3-compatible (optional)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_SIGNED_URL_TTL_SECONDS="300"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature toggles
ENABLE_GENDER_PREFERENCE="true"
REVIEW_MIN_COMMUNICATION_DAYS="3"
