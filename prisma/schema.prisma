generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  PARENT
  TUTOR
  MODERATOR
  ADMINISTRATOR
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  BANNED
  DEACTIVATED
  DELETED
}

enum TutorProfileStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  VERIFIED
  REJECTED
  SUSPENDED
}

enum RequirementStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  EXPIRED
  REMOVED
}

enum ApplicationStatus {
  SUBMITTED
  VIEWED
  SHORTLISTED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum TutoringMode {
  ONLINE
  IN_PERSON
  EITHER
}

enum LearnerLevel {
  ELEMENTARY
  MIDDLE_SCHOOL
  HIGH_SCHOOL
  COLLEGE
  ADULT
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LearningGoal {
  IMPROVE_GRADES
  UNDERSTAND_CONCEPTS
  HOMEWORK_SUPPORT
  EXAM_PREP
  CATCH_UP
  GET_AHEAD
  PROJECT_GUIDANCE
  UNIVERSITY_PREP
  TECHNICAL_SKILL
  BUILD_CONFIDENCE
  OTHER
}

enum Urgency {
  ASAP
  FEW_DAYS
  TWO_WEEKS
  ONE_MONTH
  FLEXIBLE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimePeriod {
  MORNING
  AFTERNOON
  EVENING
}

enum TeachingStyle {
  PATIENT_ENCOURAGING
  STRUCTURED_ORGANIZED
  EXAM_FOCUSED
  PROJECT_BASED
  INTERACTIVE
  FLEXIBLE_ADAPTIVE
}

enum DocumentType {
  GOVERNMENT_ID
  DEGREE
  CERTIFICATION
  RESUME
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
  ESCALATED
}

enum ModerationCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ESCALATED
  CLOSED
}

enum NotificationType {
  MESSAGE
  APPLICATION
  REVIEW
  MODERATION
  SYSTEM
  VERIFICATION
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  emailVerified     DateTime?
  passwordHash      String?
  legalName         String?
  displayName       String?
  phone             String?
  image             String?
  role              UserRole?
  status            UserStatus @default(PENDING_VERIFICATION)
  country           String?
  city              String?
  timezone          String?
  deactivatedAt     DateTime?
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  accounts          Account[]
  sessions          Session[]
  studentProfile    StudentProfile?
  parentProfile     ParentProfile?
  tutorProfile      TutorProfile?
  reportsFiled      UserReport[]       @relation("ReportsFiled")
  reportsReceived   UserReport[]       @relation("ReportsReceived")
  blocksInitiated   UserBlock[]        @relation("BlocksInitiated")
  blocksReceived    UserBlock[]        @relation("BlocksReceived")
  conversations     ConversationParticipant[]
  messagesSent      Message[]
  notifications     Notification[]
  notificationPref  NotificationPreference?
  auditLogs         AuditLog[]
  reviewsWritten    Review[]           @relation("ReviewsWritten")
  moderationCases   ModerationCase[]   @relation("ModerationAssignee")
  questionnaires    FindTutorQuestionnaire[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens EmailVerificationToken[]

  @@index([role, status])
  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  ageBand            String?
  schoolLevel        String?
  preferredSubjects  String[] @default([])
  preferredLanguage  String?
  tutoringMode       TutoringMode?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements       TutoringRequirement[]
}

model ParentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  children  ParentChildRelationship[]
  requirements TutoringRequirement[]
}

model ChildProfile {
  id                    String   @id @default(cuid())
  displayNickname       String
  privateLegalName      String?
  ageBand               String
  gradeLevel            String?
  subjects              String[] @default([])
  curriculum            String?
  learningGoals         String?
  preferredLanguage     String?
  accommodations        String?
  allowPublicPhoto      Boolean  @default(false)
  photoUrl              String?
  parentCanViewMessages Boolean  @default(true)
  deletedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  parents               ParentChildRelationship[]
  requirements          TutoringRequirement[]
  questionnaires        FindTutorQuestionnaire[]
}

model ParentChildRelationship {
  id             String       @id @default(cuid())
  parentId       String
  childId        String
  relationship   String       @default("parent")
  canMessage     Boolean      @default(true)
  createdAt      DateTime     @default(now())
  parent         ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  child          ChildProfile  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
}

model TutorProfile {
  id                    String             @id @default(cuid())
  userId                String             @unique
  slug                  String             @unique
  headline              String?
  biography             String?            @db.Text
  teachingApproach      String?            @db.Text
  yearsExperience       Int                @default(0)
  currentOccupation     String?
  educationSummary      String?            @db.Text
  teachingStyles        TeachingStyle[]    @default([])
  communityAttested     Boolean            @default(false)
  secularSubjectsOnly   Boolean            @default(false)
  conductAgreed         Boolean            @default(false)
  noReligiousInstruction Boolean           @default(false)
  termsAcceptedAt       DateTime?
  guidelinesAcceptedAt  DateTime?
  status                TutorProfileStatus @default(DRAFT)
  rejectionReason       String?
  changeRequestNotes    String?
  averageRating         Float              @default(0)
  reviewCount           Int                @default(0)
  isVerified            Boolean            @default(false)
  gender                String?
  searchDocument        String?            @db.Text
  approvedAt            DateTime?
  submittedAt           DateTime?
  deletedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects              TutorSubject[]
  qualifications        TutorQualification[]
  certifications        TutorCertification[]
  languages             TutorLanguage[]
  availability          TutorGeneralAvailability[]
  location              TutorLocation?
  verification          TutorVerification?
  applicationReviews    TutorApplicationReview[]
  applications          TutorRequirementApplication[]
  reviews               Review[]
  matches               TutorMatch[]

  @@index([status, isVerified])
  @@index([averageRating])
  @@index([deletedAt])
}

model SubjectCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  subjects    Subject[]
}

model Subject {
  id           String           @id @default(cuid())
  categoryId   String
  name         String
  slug         String           @unique
  description  String?
  aliases      String[]         @default([])
  isActive     Boolean          @default(true)
  requiresApproval Boolean      @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  category     SubjectCategory  @relation(fields: [categoryId], references: [id])
  specializations Specialization[]
  tutorSubjects TutorSubject[]
  requirements TutoringRequirement[]
  curricula    Curriculum[]     @relation("SubjectCurricula")

  @@index([name])
  @@index([isActive])
}

model Specialization {
  id          String   @id @default(cuid())
  subjectId   String
  name        String
  slug        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  tutorSubjects TutorSubject[]

  @@unique([subjectId, slug])
}

model Curriculum {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  region      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subjects    Subject[] @relation("SubjectCurricula")
  tutorSubjects TutorSubject[]
}

model TutorSubject {
  id                String   @id @default(cuid())
  tutorProfileId    String
  subjectId         String
  specializationId  String?
  curriculumId      String?
  minLevel          LearnerLevel
  maxLevel          LearnerLevel
  yearsExperience   Int      @default(0)
  onlineAvailable   Boolean  @default(true)
  inPersonAvailable Boolean  @default(false)
  individualTutoring Boolean @default(true)
  homeworkGuidance  Boolean  @default(true)
  examPreparation   Boolean  @default(true)
  projectGuidance   Boolean  @default(false)
  hourlyRate        Decimal  @db.Decimal(10, 2)
  currency          String   @default("CAD")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tutorProfile      TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subject           Subject  @relation(fields: [subjectId], references: [id])
  specialization    Specialization? @relation(fields: [specializationId], references: [id])
  curriculum        Curriculum? @relation(fields: [curriculumId], references: [id])

  @@index([tutorProfileId, subjectId])
  @@index([hourlyRate])
}

model TutorQualification {
  id             String   @id @default(cuid())
  tutorProfileId String
  title          String
  institution    String?
  year           Int?
  description    String?
  createdAt      DateTime @default(now())
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
}

model TutorCertification {
  id             String   @id @default(cuid())
  tutorProfileId String
  name           String
  issuer         String?
  year           Int?
  createdAt      DateTime @default(now())
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
}

model TutorLanguage {
  id             String   @id @default(cuid())
  tutorProfileId String
  language       String
  proficiency    String
  createdAt      DateTime @default(now())
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, language])
}

model TutorGeneralAvailability {
  id             String     @id @default(cuid())
  tutorProfileId String
  dayOfWeek      DayOfWeek
  period         TimePeriod
  timeRangeNote  String?
  createdAt      DateTime   @default(now())
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, dayOfWeek, period])
}

model TutorLocation {
  id                  String   @id @default(cuid())
  tutorProfileId       String   @unique
  onlineAvailable     Boolean  @default(true)
  inPersonAvailable   Boolean  @default(false)
  tutorTravels        Boolean  @default(false)
  studentTravels      Boolean  @default(false)
  publicMeetingOk     Boolean  @default(true)
  travelRadiusKm      Int?
  city                String?
  region              String?
  country             String?
  approximateArea     String?
  latitudeApprox      Float?
  longitudeApprox     Float?
  // Never expose street-level home address publicly
  privateAddressNote  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tutorProfile        TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([country, city])
}

model TutorVerification {
  id               String             @id @default(cuid())
  tutorProfileId    String             @unique
  status           VerificationStatus @default(NOT_SUBMITTED)
  notes            String?
  rejectionReason  String?
  reviewedById     String?
  reviewedAt       DateTime?
  submittedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tutorProfile     TutorProfile       @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  documents        VerificationDocument[]
}

model VerificationDocument {
  id             String             @id @default(cuid())
  verificationId String
  type           DocumentType
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  uploadedAt     DateTime           @default(now())
  deletedAt      DateTime?
  verification   TutorVerification  @relation(fields: [verificationId], references: [id], onDelete: Cascade)
}

model TutorApplicationReview {
  id             String   @id @default(cuid())
  tutorProfileId  String
  reviewerId     String?
  action         String
  notes          String?
  createdAt      DateTime @default(now())
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
}

model TutoringRequirement {
  id                String            @id @default(cuid())
  studentProfileId  String?
  parentProfileId   String?
  childProfileId    String?
  whoNeedsHelp      String
  subjectId         String
  topic             String?
  learnerLevel      LearnerLevel
  curriculum        String?
  learningGoal      LearningGoal?
  mode              TutoringMode
  country           String?
  city              String?
  approximateArea   String?
  preferredSchedule String?
  expectedFrequency String?
  budgetMin         Decimal?          @db.Decimal(10, 2)
  budgetMax         Decimal?          @db.Decimal(10, 2)
  currency          String            @default("CAD")
  whenNeeded        Urgency?
  description       String            @db.Text
  additionalNeeds   String?
  status            RequirementStatus @default(DRAFT)
  expiresAt         DateTime?
  publishedAt       DateTime?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  studentProfile    StudentProfile?   @relation(fields: [studentProfileId], references: [id])
  parentProfile     ParentProfile?    @relation(fields: [parentProfileId], references: [id])
  childProfile      ChildProfile?     @relation(fields: [childProfileId], references: [id])
  subject           Subject           @relation(fields: [subjectId], references: [id])
  applications      TutorRequirementApplication[]

  @@index([status, subjectId])
  @@index([country, city])
}

model TutorRequirementApplication {
  id                   String            @id @default(cuid())
  requirementId        String
  tutorProfileId        String
  introduction         String            @db.Text
  relevantExperience   String?           @db.Text
  proposedHourlyRate   Decimal           @db.Decimal(10, 2)
  currency             String            @default("CAD")
  scheduleCompatibility String?
  teachingApproach     String?
  messageToFamily      String?           @db.Text
  status               ApplicationStatus @default(SUBMITTED)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  requirement          TutoringRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  tutorProfile          TutorProfile      @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  reviewEligibility    ReviewEligibility?

  @@unique([requirementId, tutorProfileId])
  @@index([status])
}

model FindTutorQuestionnaire {
  id              String   @id @default(cuid())
  userId          String?
  guestSessionId  String?
  childProfileId  String?
  currentStep     Int      @default(1)
  answers         Json
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id])
  childProfile    ChildProfile? @relation(fields: [childProfileId], references: [id])
  matches         TutorMatch[]

  @@index([userId])
  @@index([guestSessionId])
}

model TutorMatch {
  id              String   @id @default(cuid())
  questionnaireId String
  tutorProfileId   String
  score           Float
  explanation     String   @db.Text
  mismatches      String[] @default([])
  rank            Int
  createdAt       DateTime @default(now())
  questionnaire   FindTutorQuestionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  tutorProfile     TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  factors         MatchFactor[]

  @@unique([questionnaireId, tutorProfileId])
  @@index([score])
}

model MatchFactor {
  id         String @id @default(cuid())
  matchId    String
  factorKey  String
  weight     Float
  score      Float
  reason     String
  match      TutorMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

model Conversation {
  id            String   @id @default(cuid())
  subject       String?
  relatedRequirementId String?
  involvesMinor Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  participants  ConversationParticipant[]
  messages      Message[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String   @db.Text
  flagged        Boolean  @default(false)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User     @relation(fields: [senderId], references: [id])
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id         String   @id @default(cuid())
  messageId  String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  createdAt  DateTime @default(now())
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model ReviewEligibility {
  id            String   @id @default(cuid())
  applicationId String?  @unique
  studentUserId String
  tutorProfileId String
  reason        String
  grantedAt     DateTime @default(now())
  usedAt        DateTime?
  application   TutorRequirementApplication? @relation(fields: [applicationId], references: [id])
}

model Review {
  id               String   @id @default(cuid())
  tutorProfileId    String
  authorId         String
  overallRating    Int
  subjectKnowledge Int?
  communication    Int?
  reliability      Int?
  teachingClarity  Int?
  writtenReview    String   @db.Text
  isPublic         Boolean  @default(true)
  moderated        Boolean  @default(false)
  removedAt        DateTime?
  editableUntil    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tutorProfile     TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  author           User     @relation("ReviewsWritten", fields: [authorId], references: [id])
  response         ReviewResponse?

  @@unique([tutorProfileId, authorId])
  @@index([overallRating])
}

model ReviewResponse {
  id        String   @id @default(cuid())
  reviewId  String   @unique
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model UserReport {
  id           String       @id @default(cuid())
  reporterId   String
  reportedId   String
  reason       String
  details      String?      @db.Text
  targetType   String
  targetId     String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reporter     User         @relation("ReportsFiled", fields: [reporterId], references: [id])
  reported     User         @relation("ReportsReceived", fields: [reportedId], references: [id])
  moderationCase ModerationCase?

  @@index([status])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksInitiated", fields: [blockerId], references: [id])
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

model ModerationCase {
  id           String               @id @default(cuid())
  reportId     String?              @unique
  assigneeId   String?
  title        String
  status       ModerationCaseStatus @default(OPEN)
  internalNotes String?             @db.Text
  resolution   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  report       UserReport?          @relation(fields: [reportId], references: [id])
  assignee     User?                @relation("ModerationAssignee", fields: [assigneeId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model NotificationPreference {
  id              String  @id @default(cuid())
  userId          String  @unique
  emailMessages   Boolean @default(true)
  emailApplications Boolean @default(true)
  emailReviews    Boolean @default(true)
  emailMarketing  Boolean @default(false)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model CommunityGuideline {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  body      String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ProhibitedSubject {
  id          String   @id @default(cuid())
  term        String   @unique
  aliases     String[] @default([])
  reason      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
